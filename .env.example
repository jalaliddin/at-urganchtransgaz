# AT.urtg.uz — Axborot texnologiyalari xizmatini boshqarish tizimi
# Copy with ./scripts/init-env.sh (it generates every empty secret). Never commit .env.

# ---- Docker Compose ---------------------------------------------------------
COMPOSE_PROJECT_NAME=aturtg
# Development:
COMPOSE_FILE=compose.yaml:compose.dev.yaml
# Staging / production (use instead of the line above):
# COMPOSE_FILE=compose.yaml:compose.prod.yaml
APP_PORT=8095
NGINX_SERVER_NAME=localhost
# Host user for bind-mounted files in development (filled by init-env.sh)
UID=
GID=

# ---- Application ------------------------------------------------------------
APP_NAME="AT.urtg.uz"
# local | staging | production
APP_ENV=local
APP_KEY=
# MUST be false in staging/production
APP_DEBUG=true
APP_URL=http://localhost:8095
APP_LOCALE=uz
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=uz_UZ
BCRYPT_ROUNDS=12
# Comma-separated proxy IPs/CIDRs in front of nginx, or * (only behind a trusted proxy)
TRUSTED_PROXIES=

LOG_CHANNEL=stderr
LOG_LEVEL=debug

# ---- Database (never use root for the app) -----------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=at_urtg
DB_USERNAME=at_urtg
DB_PASSWORD=
DB_ROOT_PASSWORD=

# ---- Sessions / SPA auth -----------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_DOMAIN=
# true in staging/production (HTTPS)
SESSION_SECURE_COOKIE=false
# host[:port] the SPA is served from, e.g. at.urtg.uz in production
SANCTUM_STATEFUL_DOMAINS=localhost:8095

# ---- Cache / queue ------------------------------------------------------------
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

FILESYSTEM_DISK=local

# ---- Mail (development: mailpit, UI on http://localhost:8025) -----------------
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@at.urtg.uz"
MAIL_FROM_NAME="AT.urtg.uz"

# ---- First Super Admin (php artisan app:create-super-admin --from-env) --------
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=

# ---- Development demo data (DemoSeeder never runs in production) --------------
DEMO_PASSWORD=
